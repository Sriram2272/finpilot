# Local secrets for `wrangler dev` go in .dev.vars (same format). In production use:
#   npx wrangler secret put ANTHROPIC_API_KEY
# Optional: enables Claude-powered extraction. Without it the offline parser is used.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# MongoDB connection string (Atlas free tier works: mongodb+srv://user:pass@cluster/finpilot)
MONGO_DB_URI=mongodb://localhost:27017/finpilot
# Optional: enables Claude-powered extraction. Without it the offline parser is used.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

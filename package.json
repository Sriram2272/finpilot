{
  "name": "finpilot",
  "version": "1.0.0",
  "description": "FinPilot — say or type an expense; AI turns it into a validated ledger entry (Express + React + MongoDB + Claude)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "nodemon index.js",
    "setup": "npm install && cd client && npm install && cd ..",
    "test": "node --test test/*.test.js",
    "build": "cd client && npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
